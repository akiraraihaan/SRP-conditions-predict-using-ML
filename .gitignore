# --- Environments ---
.venv/
venv/
ENV/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / OS ---
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- Training outputs (never committed) ---
runs/
weights/
*.pt
*.onnx
*.tflite
lc_tmp/

# --- Artifacts ---------------------------------------------------------
# Default-deny with an allowlist. That default has now silently swallowed an
# artefact three times -- legacy_grid_metrics.csv, folds_report.md, and then
# every output of scripts 01b and 02-07 at once -- because `git add` on an
# ignored path fails QUIETLY.
#
# So the rule is: if a script writes it under artifacts/ and it is not a model
# weight or a backup, it needs a line here. tests/test_gitignore_artefacts.py
# enumerates every path the scripts write and fails if one is missing, which is
# the check that stops this happening a fourth time.
artifacts/*

# frozen inputs -- built once by 00, then treated as read-only
!artifacts/.gitkeep
!artifacts/folds.json
!artifacts/image_index.csv
# dev_split.json is committed too: it is recovered by Route A from the legacy
# reference directory, which does not exist off-repo, so scripts 01, 01b and 02
# could not otherwise run there. See MIGRATION_NOTES.md section 13.4.
!artifacts/dev_split.json

# review artefacts -- anything meant to be READ must be committed, not merely generated
!artifacts/excluded_images.csv
!artifacts/folds_report.md
!artifacts/legacy_contamination.json

# the legacy reference, unreproducible without ../FINAL-pipeline
!artifacts/legacy_grid_metrics.csv
!artifacts/legacy_test_predictions.csv

# THE RESUME PATH. git is primary on Kaggle, Drive on Colab; committed either
# way, because it is the only record of which runs are complete.
!artifacts/registry.jsonl
# the resolved hyperparameters, snapshotted by 01, 01b and 02. epochs/batch/lr
# feed the run_id hash, so losing them silently retrains folds under an old
# config. Restore with: python scripts/restore_arms.py
!artifacts/resolved_arms.yaml

# hyperparameter search results -- these SELECT the locked configurations
# 01,  legacy augmented protocol
!artifacts/medium_grid_complete.csv
# 01b, uniform protocol
!artifacts/uniform_grid.csv
# 01b, the top-3 per arm and the selection margin in validation images
!artifacts/uniform_grid_topk.csv
# 02
!artifacts/baseline_lr_sweep.csv
# 02, the lr selection margin -- resnet18 won by 0.04 of one validation image
!artifacts/baseline_lr_sweep_topk.csv

# manuscript tables
# 06
!artifacts/summary_cv.csv
# 06
!artifacts/summary_per_class.csv
# 06
!artifacts/selected_epochs.csv
# 06, every pair of arms compared fold by fold
!artifacts/paired_comparisons.csv
# 06, which arms are on the Pareto frontier and who dominates the rest
!artifacts/pareto_status.csv
# 08, paired intervals with the Nadeau-Bengio correction. SUPERSEDES
# paired_comparisons.csv for inference; both are kept so the difference the
# correction makes is auditable rather than asserted.
!artifacts/paired_comparisons_corrected.csv
# 08, macro-F1 recomputed under merged taxonomies, from the stored confusion
# matrices. No retraining.
!artifacts/taxonomy_merge.csv
# 08, the CONTROL: all 45 single-pair merges ranked, per arm
!artifacts/taxonomy_merge_pairs.csv
# 08, per-fold merged values, so any scenario pair can be given a corrected
# interval without recomputing the merges
!artifacts/taxonomy_merge_folds.csv
# 08, where the six within-family pairs sit among all 45. The control
# reporting its own result: 1 in 8,145,060, in five architectures.
!artifacts/taxonomy_family_concentration.csv

# 11, the 2x2 that breaks the optimizer/architecture confound, plus the
# native-recipe row. Preprocessing is NOT constant across rows; the column says so.
!artifacts/yolo_recipe_check.csv
# 11, C1: yolo26n with the epoch budget raised 25 -> 50
!artifacts/epoch_budget_check.csv
# 11, C1: where best-weight selection landed, appendix C form
!artifacts/epoch_budget_selection.csv

# 10, quantisation: size and accuracy for dynamic and static PTQ. NO LATENCY.
!artifacts/quantisation.csv

# 09, near-duplicate clusters and whether any straddles a fold boundary.
# Corpus-level, so no arm and no protocol: identified by corpus_fingerprint.
!artifacts/near_duplicates.csv
!artifacts/near_duplicate_summary.json
# 09, the ten largest clusters as thumbnails. The cheapest check of all: if a
# 37-image cluster is visibly 37 different cards, one glance settles it.
!artifacts/near_duplicate_contact_sheet.png
# 09, EXACT decoded-pixel duplicate groups. The check that found the one
# residual file sha1 could not: a re-encode keeps the pixels, changes the bytes.
!artifacts/pixel_duplicates.csv

# 04
!artifacts/ablation_paired.csv
# 04
!artifacts/ablation_per_class.csv
# 05
!artifacts/learning_curve.csv
# 07, Raspberry Pi
!artifacts/edge_benchmark.json
# 07, the Pareto frontier recomputed on MEASURED latency rather than GFLOPs
!artifacts/pareto_status_device.csv
# 07, run per DEVICE. --out may point at a subdirectory so results from several
# boards can sit side by side, and `artifacts/*` matches that directory, which
# stops git descending into it at all. Un-ignoring the directory is enough --
# its contents are not matched by `artifacts/*`, which is one level only.
# One line per board. A device whose results are not listed here is silently
# uncommittable, which is the failure this whole allowlist exists to catch.
!artifacts/raspberry-pi-result/

# publication figures. `artifacts/*` matches the directory but not its contents,
# so un-ignoring the directory is enough to let git descend into it.
# BOTH sets are kept: figures/ carries the provenance strip and is what catches a
# stale file; figures_pub/ is the same figures without the strip, for typesetting,
# with the provenance in the file metadata instead.
!artifacts/figures/
!artifacts/figures_pub/

# NOT committed, deliberately: registry backups written by backfill_efficiency.py
artifacts/*.bak
