# --- Environments ---
.venv/
venv/
ENV/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / OS ---
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- Training outputs (never committed) ---
runs/
weights/
*.pt
*.onnx
*.tflite
lc_tmp/

# --- Artifacts: generated, NOT committed ... ---
artifacts/*

# --- ... except these, which are frozen inputs or review artefacts ---
!artifacts/.gitkeep
!artifacts/folds.json
!artifacts/image_index.csv
# dev_split.json is committed too: it is recovered by Route A from the legacy
# reference directory, which does not exist on Kaggle, so scripts 01 and 02
# could not otherwise run there. See MIGRATION_NOTES.md section 13.4.
!artifacts/dev_split.json
# the audit trail for the 27 excluded images -- small, and quoted in the paper
!artifacts/excluded_images.csv
# any artefact that is meant to be REVIEWED must be committed, not merely generated
!artifacts/folds_report.md
!artifacts/legacy_contamination.json
# the 46 completed legacy grid configurations. Script 01 recomputes the argmax
# over all 18 medium configs and needs these on Kaggle, where the legacy
# reference directory ../FINAL-pipeline does not exist and cannot be re-read.
!artifacts/legacy_grid_metrics.csv
# per-image predictions behind legacy cross-reference 2; quoted in the paper and
# not reproducible without the legacy weights
!artifacts/legacy_test_predictions.csv
# THE RESUME PATH. git is PRIMARY: commit registry.jsonl at the end of every
# Kaggle session, and the next session's `git clone` restores it, so every
# script skips the runs it already contains. RESUME_FROM in the notebook is the
# documented fallback, not the normal route. See HANDOVER.md section 4.
!artifacts/registry.jsonl
